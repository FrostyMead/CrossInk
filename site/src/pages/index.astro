---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getDocs } from '../lib/docs';

const docs = await getDocs();
const featuredDocs = docs.filter((doc) =>
  ['user-guide', 'installation', 'reader-features', 'webserver'].includes(doc.slug)
);
---

<SiteLayout
  title="FrostInk"
  description="A focused personal e-reader firmware for the Xteink X4, built on CrossInk and CrossPoint."
  pageClass="home"
>
  <section slot="hero" class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Built on <a href="https://github.com/uxjulia/CrossInk">CrossInk</a> and CrossPoint</p>
      <h1>Frost<span class="frostink-serif">I</span>nk</h1>
      <p class="hero-text">
        A calm Frost theme, refined e-ink interactions, and a safer custom update path.
      </p>
      <div class="hero-actions">
        <a class="button primary" href="/installation.html">Installation Instructions</a>
        <a class="button" href="/reader-features.html">Explore features</a>
      </div>
    </div>
    <img
      src="/images/bitter-small-15-margin.jpg"
      alt="FrostInk on an X4 using 10pt Bitter font"
      class="hero-image"
      loading="eager"
    />
  </section>

  <section class="section-heading">
    <p class="eyebrow">Start here</p>
    <h2>Useful docs</h2>
  </section>
  <nav class="useful-docs" aria-label="Useful documentation">
    {
      featuredDocs.map((doc) => (
        <a href={doc.url}>
          <span>{doc.title}</span>
        </a>
      ))
    }
  </nav>
</SiteLayout>
